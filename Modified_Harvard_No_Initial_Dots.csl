<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-GB">

  <info>
    <title>Modified Harvard - No Initial Dots</title>
    <id>http://www.zotero.org/styles/modified-harvard-no-initial-dots</id>

    <link href="http://www.zotero.org/styles/modified-harvard-no-initial-dots"
          rel="self"/>

    <author>
      <name>Rabia Shahid</name>
    </author>

    <category citation-format="author-date"/>

    <summary>
      Harvard style with initials without dots, year in parentheses,
      sentence-case article titles, italicized journal and book titles,
      and volume:pages formatting.
    </summary>

    <updated>2026-11-08T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="en-GB">
    <terms>
      <term name="and">and</term>
      <term name="et-al">et al.</term>
      <term name="edition" form="short">edn.</term>
    </terms>
  </locale>

  <!-- AUTHOR -->
  <macro name="author">
    <names variable="author">
      <name
        initialize="true"
        initialize-with=""
        delimiter=", "
        delimiter-precedes-last="never"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- YEAR -->
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- PUBLISHER -->
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <!-- IN-TEXT CITATION -->
  <citation et-al-min="4" et-al-use-first="3">
    <sort>
      <key macro="author"/>
      <key macro="year"/>
    </sort>

    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <!-- BIBLIOGRAPHY -->
  <bibliography hanging-indent="true"
                et-al-min="4"
                et-al-use-first="3">

    <sort>
      <key macro="author"/>
      <key macro="year"/>
    </sort>

    <layout suffix=".">

      <choose>

        <!-- BOOK -->
        <if type="book">
          <group delimiter=" ">
            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <text variable="title"
                  font-style="italic"
                  text-case="title"/>

            <text variable="edition" suffix=" edn."/>

            <text macro="publisher"/>
          </group>
        </if>

        <!-- BOOK CHAPTER -->
        <else-if type="chapter">
          <group delimiter=" ">
            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <text variable="title"
                  text-case="sentence"/>

            <group delimiter=" ">
              <text value="In:"/>

              <names variable="editor">
                <name initialize="true"
                      initialize-with=""/>
                <label form="short"
                       prefix=" ("
                       suffix=")"/>
              </names>

              <text variable="container-title"
                    font-style="italic"
                    text-case="title"/>
            </group>

            <text macro="publisher"/>

            <group>
              <label variable="page"
                     form="short"
                     suffix=" "/>
              <text variable="page"/>
            </group>
          </group>
        </else-if>

        <!-- JOURNAL ARTICLE -->
        <else-if type="article-journal">
          <group delimiter=" ">

            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <text variable="title"
                  text-case="sentence"/>

            <group delimiter=" ">

              <text variable="container-title"
                    font-style="italic"
                    text-case="title"/>

              <text variable="volume"/>

              <group delimiter="">
                <text value=":"/>
                <choose>
                  <if variable="page">
                    <text variable="page"/>
                  </if>
                  <else>
                    <text 
