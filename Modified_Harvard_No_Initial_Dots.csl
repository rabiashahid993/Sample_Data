<else-if type="webpage post-weblog">
  <group delimiter=" ">
    <text macro="author"/>

    <group prefix="(" suffix=")">
      <text macro="year"/>
    </group>

    <text variable="title"/>

    <text variable="container-title" font-style="italic"/>

    <text variable="URL"/>

    <group prefix="[Accessed " suffix="]">
      <date variable="accessed">
        <date-part name="day"/>
        <date-part name="month" form="long"/>
        <date-part name="year"/>
      </date>
    </group>
  </group>
</else-if>
