<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-GB">

  <info>
    <title>Modified Harvard - No Initial Dots (Custom)</title>
    <id>http://www.zotero.org/styles/modified-harvard-no-initial-dots-custom</id>
    <link href="http://www.zotero.org/styles/modified-harvard-no-initial-dots-custom" rel="self"/>
    <category citation-format="author-date"/>
    <summary>
      Modified Harvard style: author initials without dots, year in parentheses,
      sentence-case article titles, italicized title-case journal and book titles,
      and volume followed by colon and pages.
    </summary>
    <updated>2026-11-08T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="en-GB">
    <terms>
      <term name="and">and</term>
      <term name="et-al">et al.</term>
      <term name="edition" form="short">edn.</term>
    </terms>
  </locale>

  <!-- AUTHOR -->
  <macro name="author">
    <names variable="author">
      <name
        name-as-sort-order="all"
        sort-separator=" "
        initialize="true"
        initialize-with=""
        delimiter=", "
        delimiter-precedes-last="never"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- YEAR -->
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- PUBLISHER -->
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <!-- IN-TEXT CITATIONS -->
  <citation et-al-min="4" et-al-use-first="3">
    <sort>
      <key macro="author"/>
      <key macro="year"/>
    </sort>

    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <!-- BIBLIOGRAPHY -->
  <bibliography hanging-indent="true"
                et-al-min="4"
                et-al-use-first="3">

    <sort>
      <key macro="author"/>
      <key macro="year"/>
    </sort>

    <layout suffix=".">

      <choose>

        <!-- BOOK -->

        <if type="book">

          <group delimiter=" ">

            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <group delimiter=", ">
              <text variable="title"
                    font-style="italic"
                    text-case="title"/>
              <text variable="edition"
                    suffix=" edn."/>
            </group>

            <text macro="publisher"/>

          </group>

        </if>

        <!-- CHAPTER / CONFERENCE PAPER -->

        <else-if type="chapter paper-conference">

          <group delimiter=" ">

            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <text variable="title"
                  text-case="sentence"/>

            <group delimiter=" ">

              <text value="In:"/>

              <names variable="editor">
                <name
                  name-as-sort-order="all"
                  sort-separator=" "
                  initialize="true"
                  initialize-with=""
                  delimiter=", "
                  delimiter-precedes-last="never"/>
                <label form="short"
                       prefix=" ("
                       suffix=")"/>
              </names>

              <text variable="container-title"
                    font-style="italic"
                    text-case="title"/>

            </group>

            <text macro="publisher"/>

            <group>
              <label variable="page"
                     form="short"
                     suffix=" "/>
              <text variable="page"/>
            </group>

          </group>

        </else-if>

        <!-- JOURNAL ARTICLE -->

        <else-if type="article-journal">

          <group delimiter=" ">

            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <text variable="title"
                  text-case="sentence"/>

            <group delimiter=" ">

              <text variable="container-title"
                    font-style="italic"
                    text-case="title"/>

              <text variable="volume"/>

              <group delimiter="">
                <text value=":"/>

                <choose>

                  <if variable="page">
                    <text variable="page"/>
                  </if>

                  <else>
                    <text variable="article-number"/>
                  </else>

                </choose>

              </group>

            </group>

            <text variable="DOI"
                  prefix="https://doi.org/"/>

          </group>

        </else-if>

        <!-- DEFAULT TYPE -->

        <else>

          <group delimiter=" ">

            <text macro="author"/>

            <group prefix="(" suffix=")">
              <text macro="year"/>
            </group>

            <text variable="title"
                  font-style="italic"/>

            <text macro="publisher"/>

          </group>

        </else>

      </choose>

    </layout>

  </bibliography>

</style>
